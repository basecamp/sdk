# {{.AppTitle}} SDK Makefile

.PHONY: all check clean help

# Default: run all checks
all: check

#---
# Smithy targets
#---

.PHONY: smithy-validate smithy-build smithy-check smithy-clean smithy-mapper

smithy-mapper:
	@echo "==> Building Smithy mapper plugin..."
	cd spec/smithy-bare-arrays && ./gradlew publishToMavenLocal --quiet

smithy-validate:
	@echo "==> Validating Smithy spec..."
	cd spec && smithy validate

smithy-build: behavior-model smithy-mapper
	@echo "==> Building OpenAPI from Smithy..."
	cd spec && smithy build
	@cp spec/build/smithy/openapi/openapi/{{.AppTitle}}.openapi.json openapi.json
	@echo "==> Post-processing OpenAPI for Go types..."
	./scripts/enhance-openapi-go-types.sh
	@echo "==> OpenAPI spec generated: openapi.json"
	@$(MAKE) sync-api-version

smithy-check: smithy-validate smithy-mapper
	@echo "==> Checking OpenAPI freshness..."
	@cd spec && smithy build
	@TMPFILE=$$(mktemp) && \
		cp spec/build/smithy/openapi/openapi/{{.AppTitle}}.openapi.json "$$TMPFILE" && \
		./scripts/enhance-openapi-go-types.sh "$$TMPFILE" "$$TMPFILE" > /dev/null 2>&1 && \
		(diff -q openapi.json "$$TMPFILE" > /dev/null 2>&1 || \
			(rm -f "$$TMPFILE" && echo "ERROR: openapi.json is out of date. Run 'make smithy-build'" && exit 1)) && \
		rm -f "$$TMPFILE"
	@echo "  openapi.json is fresh"

smithy-clean:
	rm -rf spec/build spec/smithy-bare-arrays/build spec/smithy-bare-arrays/.gradle

#---
# Behavior Model
#---

.PHONY: behavior-model behavior-model-check

behavior-model:
	@echo "==> Generating behavior model..."
	./scripts/generate-behavior-model
	@echo "  behavior-model.json generated"

behavior-model-check:
	@echo "==> Checking behavior model freshness..."
	@./scripts/generate-behavior-model --check

#---
# URL Routes
#---

.PHONY: url-routes url-routes-check

url-routes:
	@echo "==> Generating URL routes..."
	./scripts/generate-url-routes

url-routes-check:
	@echo "==> Checking URL routes freshness..."
	@./scripts/generate-url-routes --check

#---
# API Version Sync
#---

.PHONY: sync-api-version sync-api-version-check

sync-api-version:
	@echo "==> Syncing API version..."
	./scripts/sync-api-version.sh
	@# Rust: the generator emits this constant from the same openapi.json, so the rewrite
	@# is idempotent after rs-generate-services; it exists so a spec bump that skips
	@# regeneration still leaves the constant true.
	@API_VER=$$(jq -r '.info.version' openapi.json); \
	[ ! -f rust/sdk/src/generated/mod.rs ] || \
		perl -pi -e "s/^pub const API_VERSION: &str = \".*\";/pub const API_VERSION: &str = \"$$API_VER\";/" rust/sdk/src/generated/mod.rs

sync-api-version-check:
	@echo "==> Checking API version sync..."
	@# A language the profile omits has no constant to check; a language it carries
	@# must match. Each line skips an absent file and fails a present one that differs.
	@API_VER=$$(jq -r '.info.version' openapi.json); \
	ok=true; \
	f=go/pkg/{{.AppLower}}/version.go; [ ! -f $$f ] || grep -q "APIVersion = \"$$API_VER\"" $$f || ok=false; \
	f=typescript/src/client.ts; [ ! -f $$f ] || grep -q "API_VERSION = ['\"]$$API_VER['\"]" $$f || ok=false; \
	f=ruby/lib/{{.AppLower}}/version.rb; [ ! -f $$f ] || grep -q "API_VERSION = \"$$API_VER\"" $$f || ok=false; \
	f=kotlin/sdk/src/commonMain/kotlin/com/basecamp/{{.AppLower}}/{{.AppTitle}}Config.kt; [ ! -f $$f ] || grep -q "API_VERSION = \"$$API_VER\"" $$f || ok=false; \
	f=swift/Sources/{{.AppTitle}}/{{.AppTitle}}Config.swift; [ ! -f $$f ] || grep -q "apiVersion = \"$$API_VER\"" $$f || ok=false; \
	f=rust/sdk/src/generated/mod.rs; [ ! -f $$f ] || grep -q "pub const API_VERSION: &str = \"$$API_VER\";" $$f || ok=false; \
	if [ "$$ok" = false ]; then echo "ERROR: API_VERSION constants out of sync. Run 'make sync-api-version'"; exit 1; fi
	@echo "  API version is in sync"

#---
# Provenance
#---

.PHONY: provenance-sync provenance-check sync-status

provenance-sync:
	@echo "==> Syncing provenance..."
	@cp spec/api-provenance.json go/pkg/{{.AppLower}}/api-provenance.json
	@echo "  Provenance synced"

provenance-check:
	@echo "==> Checking provenance..."
	@diff -q spec/api-provenance.json go/pkg/{{.AppLower}}/api-provenance.json > /dev/null 2>&1 || \
		(echo "ERROR: go/pkg/{{.AppLower}}/api-provenance.json is out of date. Run 'make provenance-sync'" && exit 1)
	@echo "  Provenance is in sync"

sync-status:
	@REV=$$(jq -r '.{{.AppLower}}.revision' spec/api-provenance.json); \
	if [ -z "$$REV" ] || [ "$$REV" = "null" ] || [ "$$REV" = "" ]; then \
		echo "No revision recorded in api-provenance.json."; \
		exit 0; \
	fi; \
	echo "==> Checking for upstream changes since $$REV..."; \
	gh api "repos/basecamp/{{.AppLower}}/compare/$$REV...main" --jq '.ahead_by' 2>/dev/null | xargs -I{} echo "  {} commits ahead" || \
		echo "  Could not query upstream (check gh auth)"

