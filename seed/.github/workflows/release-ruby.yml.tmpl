name: Release Ruby SDK

on:
  push:
    tags:
      - 'v*'
  workflow_dispatch:  # Manual trigger is always dry-run (rehearsal mode)

permissions: {}

jobs:
  smithy:
    permissions:
      contents: read
    uses: $/.github/workflows/smithy-verify.yml

  test:
    name: Test Ruby SDK
    runs-on: ubuntu-latest
    permissions:
      contents: read
    defaults:
      run:
        working-directory: ruby
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false

      - name: Set up Ruby
        uses: ruby/setup-ruby@95ef2b042f9d7a56d8268cba8559e2842e2ad01b # v1.321.0 # zizmor: ignore[cache-poisoning] -- cached deps are for testing, not release artifact generation
        with:
          ruby-version: '3.3'
          bundler-cache: true
          working-directory: ruby

      - name: Lint
        run: bundle exec rubocop

      - name: Run tests
        run: bundle exec rake test

  publish:
    name: Publish to RubyGems
    needs: [smithy, test]
    runs-on: ubuntu-latest
    environment: release-rubygems
    permissions:
      contents: read
      id-token: write
    defaults:
      run:
        working-directory: ruby
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Verify tag is on main
        if: github.event_name == 'push'
        run: |
          git fetch origin main
          git merge-base --is-ancestor "$GITHUB_SHA" origin/main

      - name: Set up Ruby
        uses: ruby/setup-ruby@95ef2b042f9d7a56d8268cba8559e2842e2ad01b # v1.321.0 # zizmor: ignore[cache-poisoning] -- cache is branch-isolated; fork PRs cannot write to this cache
        with:
          ruby-version: '3.3'
          bundler-cache: true
          working-directory: ruby

      - name: Extract version
        id: version
        env:
          EVENT_NAME: ${{ github.event_name }}
        run: |
          if [[ "$EVENT_NAME" == "workflow_dispatch" ]]; then
            # Manual trigger (dry-run): read from version.rb
            VERSION=$(ruby -e "require_relative 'lib/sdk/version'; puts {{.RubyModule}}::VERSION")
            echo "version=$VERSION" >> "$GITHUB_OUTPUT"
            echo "Rehearsal for version: $VERSION"
          else
            # Tag trigger: extract from tag (v0.2.1 → 0.2.1)
            VERSION="${GITHUB_REF#refs/tags/v}"
            GEM_VERSION=$(ruby -e "require_relative 'lib/{{.RubyGem | snakecase}}/version'; puts {{.RubyModule}}::VERSION")
            if [ "$GEM_VERSION" != "$VERSION" ]; then
              echo "::error::Gem version ($GEM_VERSION) does not match tag version ($VERSION)"
              exit 1
            fi
            echo "version=$VERSION" >> "$GITHUB_OUTPUT"
            echo "Releasing version: $VERSION"
          fi

      - name: Configure RubyGems credentials
        if: github.event_name == 'push'
        uses: rubygems/configure-rubygems-credentials@dc5a8d8553e6ee01fc26761a49e99e733d17954a # v2.1.0

      - name: Publish to RubyGems
        id: publish
        if: github.event_name == 'push'
        shell: bash
        env:
          VERSION: ${{ steps.version.outputs.version }}
        run: |
          gem build {{.RubyGem}}.gemspec
          set +e
          output=$(gem push "{{.RubyGem}}-${VERSION}.gem" 2>&1)
          status=$?
          set -e
          echo "$output"
          if [ "$status" -eq 0 ]; then
            echo "Publish succeeded."
            echo "pushed=true" >> "$GITHUB_OUTPUT"
          elif grep -qi "repushing of gem versions is not allowed\|already been pushed" <<<"$output"; then
            echo "Version already published — treating as success for idempotency."
          else
            exit "$status"
          fi

      # rubygems-await used to run here. It reads the compact index through
      # Bundler's CompactIndexClient; Bundler 4.1.0, which `gem exec` installs
      # beside it, moved that class out of the Bundler namespace, and the
      # fallback then asks RubyGems' cache for a method it does not have. It
      # crashes on every poll, so it times out after a push that worked, as
      # it did for basecamp-sdk v0.38.0 and v0.39.0.
      #
      # This waits on what `gem install` and Bundler fetch, all from the
      # public index:
      #   - /info/{{.RubyGem}} has the version's line, and the sha256 that line
      #     names is the .gem's (Bundler refuses a download that differs);
      #   - /versions' last line for {{.RubyGem}} carries that file's MD5,
      #     which is how Bundler knows its cached copy is stale (read from
      #     the file's tail, where new lines are appended, and in full only
      #     when the tail has none);
      #   - the quick gemspec that RubyGems before 4.1 reads to install, as
      #     this gem's spec at this version, read with RubyGems' own safe
      #     loader (never Marshal.load on downloaded data), not merely a 200;
      #   - the .gem itself, whose sha256 must match the v2 API's.
      # When this job did the push, that sha256 must also be the gem it
      # pushed. A run that found the version already published may have
      # rebuilt the gem (a full re-run does, and `gem build` stamps it with
      # the time), so its local file is not compared. A check that has passed
      # is not repeated while what it read stays the same, so a re-run long
      # after a release stops reading the full /versions once it has matched. Each request gives up after a
      # minute (the full /versions after three) or at the ten-minute deadline,
      # whichever is sooner, so the step reports what was missing well inside
      # its fifteen-minute limit.
      - name: Wait until the gem is installable
        if: github.event_name == 'push'
        shell: bash
        timeout-minutes: 15
        env:
          VERSION: ${{ steps.version.outputs.version }}
          PUSHED: ${{ steps.publish.outputs.pushed }}
          AWAIT_SECONDS: 600
        run: |
          want=""
          if [ "$PUSHED" = true ]; then
            want=$(sha256sum "{{.RubyGem}}-${VERSION}.gem" | cut -d' ' -f1)
          fi
          # No request starts after the deadline, and none runs more than a
          # second past it (SECONDS counts whole seconds).
          fetch() {
            local left=$((deadline - SECONDS)) max=${limit:-60}
            [ "$left" -gt 0 ] || return 1
            [ "$left" -lt "$max" ] && max=$left
            curl -fsS --connect-timeout 10 --max-time "$max" -o "$2" "${@:3}" "$1" 2>/dev/null
          }
          index_line() { { tail -n +2 "$1" | grep '^{{.RubyGem}} ' || true; } | tail -n 1 | awk '{print $NF}'; }
          scratch=$(mktemp -d)
          deadline=$((SECONDS + AWAIT_SECONDS))
          info=no listed=no spec=no api="" file="" indexed="" verified=""
          while :; do
            # Read again while the index names another sha256 than the API's:
            # metadata that disagrees is not yet the release. What the last read
            # found stands until a newer read replaces it, and the /info body
            # /versions last vouched for is not checked against it again.
            if [ "$listed" = no ] || { [ -n "$api" ] && [ "$indexed" != "$api" ]; }; then
              line=""
              if fetch "https://index.rubygems.org/info/{{.RubyGem}}" "$scratch/info"; then
                info=no indexed=""
                line=$({ grep "^${VERSION//./\\.} " "$scratch/info" || true; } | tail -n 1)
              fi
              if [ -n "$line" ]; then
                info=yes
                indexed=$(sed -nE 's/.*[|,]checksum:([0-9a-f]{64})(,.*)?$/\1/p' <<<"$line")
                md5=$(md5sum "$scratch/info" | cut -d' ' -f1)
                if [ "$md5" != "$verified" ]; then
                  listed=no
                  last=""
                  if fetch "https://index.rubygems.org/versions" "$scratch/versions" -r -2000000; then
                    last=$(index_line "$scratch/versions")
                  fi
                  if [ -z "$last" ] && limit=180 fetch "https://index.rubygems.org/versions" "$scratch/versions"; then
                    last=$(index_line "$scratch/versions")
                  fi
                  if [ "$last" = "$md5" ]; then
                    listed=yes verified=$md5
                  fi
                fi
              elif [ "$info" = no ]; then
                listed=no
              fi
            fi
            if [ "$spec" = no ] && fetch "https://rubygems.org/quick/Marshal.4.8/{{.RubyGem}}-${VERSION}.gemspec.rz" "$scratch/spec" \
                && ruby -rzlib -rrubygems/safe_marshal -e '
                     spec = Gem::SafeMarshal.safe_load(Zlib::Inflate.inflate(File.binread(ARGV[0])))
                     exit(spec.is_a?(Gem::Specification) && spec.name == ARGV[1] && spec.version.to_s == ARGV[2])
                   ' "$scratch/spec" "{{.RubyGem}}" "$VERSION" 2>/dev/null; then
              spec=yes
            fi
            if [ -z "$api" ] && fetch "https://rubygems.org/api/v2/rubygems/{{.RubyGem}}/versions/${VERSION}.json" "$scratch/api.json"; then
              api=$(jq -r '.sha // empty' "$scratch/api.json" 2>/dev/null || true)
              [[ "$api" =~ ^[0-9a-f]{64}$ ]] || api=""
            fi
            if [ -n "$want" ] && [ -n "$api" ] && [ "$api" != "$want" ]; then
              echo "::error::RubyGems reports {{.RubyGem}} ${VERSION} with sha256 ${api}, not the ${want} this job pushed."
              exit 1
            fi
            if [ -n "$api" ] && [ "$file" != "$api" ] && fetch "https://rubygems.org/gems/{{.RubyGem}}-${VERSION}.gem" "$scratch/gem"; then
              file=$(sha256sum "$scratch/gem" | cut -d' ' -f1)
            fi
            state="info: ${info}, versions: ${listed}, gemspec: ${spec}, API sha256: ${api:-none}, index sha256: ${indexed:-none}, downloaded sha256: ${file:-none}"
            if [ "$info" = yes ] && [ "$listed" = yes ] && [ "$spec" = yes ] && [ -n "$api" ] && [ "$indexed" = "$api" ] && [ "$file" = "$api" ]; then
              echo "{{.RubyGem}} ${VERSION} is installable (${state})."
              exit 0
            fi
            if [ "$SECONDS" -ge "$deadline" ]; then
              echo "::error::{{.RubyGem}} ${VERSION} was not installable after ${AWAIT_SECONDS}s of polling (${state})."
              exit 1
            fi
            echo "Waiting for {{.RubyGem}} ${VERSION} (${state})..."
            sleep 15
          done

      - name: Dry-run build
        if: github.event_name == 'workflow_dispatch'
        env:
          VERSION: ${{ steps.version.outputs.version }}
        run: |
          gem build {{.RubyGem}}.gemspec
          echo "::notice::Dry run mode - not actually publishing"
          echo "Would publish: {{.RubyGem}}-${VERSION}.gem"
