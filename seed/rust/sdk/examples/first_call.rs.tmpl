//! The first call: build a client for one account.
//!
//! ```sh
//! {{.AppName | upper}}_TOKEN=… {{.AppName | upper}}_ACCOUNT_ID=999 cargo run --example first_call
//! ```

#![allow(clippy::unwrap_used, clippy::expect_used)] // an example stops on a missing environment variable

use {{.AppName}}_sdk::{Client, Config};

#[tokio::main]
async fn main() -> Result<(), {{.AppName}}_sdk::Error> {
    let token = std::env::var("{{.AppName | upper}}_TOKEN").expect("{{.AppName | upper}}_TOKEN");
    let account_id = std::env::var("{{.AppName | upper}}_ACCOUNT_ID").expect("{{.AppName | upper}}_ACCOUNT_ID");

    let client = Client::builder(Config::from_env()?)
        .access_token(token)
        .build()?;
    let account = client.for_account(account_id);

    // Once `make rs-generate-services` has run, the generated services hang off `account`:
    // account.projects().list(&Default::default()).await?, and so on.
    println!(
        "{} {} ready for account {} at {}",
        {{.AppName}}_sdk::VERSION,
        {{.AppName}}_sdk::API_VERSION,
        account.account_id(),
        account.base_url()
    );
    Ok(())
}
