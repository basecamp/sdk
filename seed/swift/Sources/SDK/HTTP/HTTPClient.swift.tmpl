import Foundation

/// Internal HTTP client with authentication, retry, and hooks.
package final class HTTPClient: Sendable {
    private let transport: any Transport
    private let authStrategy: any AuthStrategy
    private let config: {{.SwiftPackage}}Config
    private let hooks: any {{.SwiftPackage}}Hooks

    package init(
        transport: any Transport,
        authStrategy: any AuthStrategy,
        config: {{.SwiftPackage}}Config,
        hooks: any {{.SwiftPackage}}Hooks
    ) {
        self.transport = transport
        self.authStrategy = authStrategy
        self.config = config
        self.hooks = hooks
    }

    /// Performs an HTTP request with retry and hooks lifecycle.
    package func performRequest(
        method: String,
        url: String,
        body: Data? = nil
    ) async throws -> (Data, HTTPURLResponse) {
        guard let requestURL = URL(string: url) else {
            throw {{.SwiftPackage}}Error.usage(message: "Invalid URL: \(url)", hint: nil)
        }

        var request = URLRequest(url: requestURL)
        request.httpMethod = method
        request.timeoutInterval = config.timeoutInterval

        try await authStrategy.authenticate(&request)
        request.setValue(config.userAgent, forHTTPHeaderField: "User-Agent")
        request.setValue("application/json", forHTTPHeaderField: "Accept")

        if body != nil {
            request.setValue("application/json", forHTTPHeaderField: "Content-Type")
        }
        request.httpBody = body

        let maxAttempts = config.enableRetry ? 3 : 1

        for attempt in 1...maxAttempts {
            let info = RequestInfo(method: method, url: url, attempt: attempt)
            hooks.onRequestStart(info)
            let startTime = CFAbsoluteTimeGetCurrent()

            do {
                let (data, response) = try await transport.data(for: request)

                guard let httpResponse = response as? HTTPURLResponse else {
                    throw {{.SwiftPackage}}Error.network(message: "Invalid response type", cause: nil)
                }

                let durationMs = Int((CFAbsoluteTimeGetCurrent() - startTime) * 1000)
                hooks.onRequestEnd(info, result: RequestResult(statusCode: httpResponse.statusCode, durationMs: durationMs))

                let statusCode = httpResponse.statusCode
                if [429, 503].contains(statusCode), attempt < maxAttempts {
                    let delay = TimeInterval(1 << (attempt - 1)) + Double.random(in: 0...0.1)
                    try await Task.sleep(nanoseconds: UInt64(delay * 1_000_000_000))
                    try await authStrategy.authenticate(&request)
                    continue
                }

                return (data, httpResponse)
            } catch let error as {{.SwiftPackage}}Error {
                throw error
            } catch {
                if attempt < maxAttempts {
                    let delay = TimeInterval(1 << (attempt - 1)) + Double.random(in: 0...0.1)
                    try await Task.sleep(nanoseconds: UInt64(delay * 1_000_000_000))
                    continue
                }
                throw {{.SwiftPackage}}Error.network(message: "Network error", cause: error)
            }
        }

        throw {{.SwiftPackage}}Error.network(message: "Request failed after \(maxAttempts) attempts", cause: nil)
    }
}
